{
  "name": "grape",
  "version": "0.0.1",
  "author": "NaughtySora",
  "private": true,
  "license": "MIT",
  "scripts": {
    "public:start": "nest start public",
    "public:build": "nest build public",
    "public:dev": "nest start public --watch",
    "public:run": "node ./dist/src/services/public/main.js",
    "public:test": "jest --testTimeout=50000 src/services/public",
    "public:image:build": "docker image build --no-cache --progress=plain -f src/services/public/Dockerfile -t user_public:latest .",
    "public:image:run": "bash -c 'source .public.env && docker container run --env-file .env  --env-file .public.env -e POSTGRES_HOST=postgres -e PUBLIC_DB_HOST=postgres --network user_user_public_net --name public -p 3000:$PUBLIC_HTTP_PORT user_public:latest'",
    "public:image:stop": "docker kill --signal=SIGTERM public",
    "public:compose:up": "docker compose --project-directory . --env-file .env --env-file .public.env -f src/services/public/docker-compose.yml up",
    "public:dev:compose:up": "docker compose --project-directory . --env-file .env --env-file .public.env -f src/services/public/docker-compose.yml up --scale server=0",
    "public:compose:down": "docker compose --project-directory . --env-file .env --env-file .public.env -f src/services/public/docker-compose.yml down",
    "integration:start": "nest start integration",
    "integration:build": "nest build integration",
    "integration:dev": "nest start integration --watch",
    "integration:run": "node ./dist/src/services/integration/main.js",
    "integration:test": "jest --testTimeout=50000 src/services/integration",
    "integration:image:build": "docker image build --no-cache --progress=plain -f src/services/integration/Dockerfile -t user_integration:latest .",
    "integration:image:run": "bash -c 'source .integration.env && docker container run --env-file .env --env-file .integration.env POSTGRES_HOST=postgres -e INTEGRATION_DB_HOST=postgres --network user_user_integration_net --name integration -p 3000:$INTEGRATION_HTTP_PORT user_integration:latest'",
    "integration:image:stop": "docker kill --signal=SIGTERM integration",
    "integration:compose:up": "docker compose --project-directory . --env-file .env --env-file .integration.env -f src/services/integration/docker-compose.yml up",
    "integration:dev:compose:up": "docker compose --project-directory . --env-file .env --env-file .integration.env -f src/services/integration/docker-compose.yml up --scale server=0",
    "integration:compose:down": "docker compose --project-directory . --env-file .env --env-file .integration.env -f src/services/integration/docker-compose.yml down",
    "admin:start": "nest start admin",
    "admin:build": "nest build admin",
    "admin:dev": "nest start admin --watch",
    "admin:run": "node ./dist/src/services/admin/main.js",
    "admin:test": "jest --testTimeout=50000 src/services/admin",
    "admin:image:build": "docker image build --no-cache --progress=plain -f src/services/admin/Dockerfile -t user_admin:latest .",
    "admin:image:run": "bash -c 'source .admin.env && docker container run --env-file .env  --env-file .admin.env -e POSTGRES_HOST=postgres -e ADMIN_DB_HOST=postgres --network user_user_admin_net --name admin -p 3000:$ADMIN_HTTP_PORT user_admin:latest'",
    "admin:image:stop": "docker kill --signal=SIGTERM admin",
    "admin:compose:up": "docker compose --project-directory . --env-file .env --env-file .admin.env -f src/services/admin/docker-compose.yml up",
    "admin:dev:compose:up": "docker compose --project-directory . --env-file .env --env-file .admin.env -f src/services/admin/docker-compose.yml up --scale server=0",
    "admin:compose:down": "docker compose --project-directory . --env-file .env --env-file .admin.env -f src/services/admin/docker-compose.yml down",
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "test": "jest --testTimeout=50000",
    "typeorm": "NODE_OPTIONS=\"-r ts-node/register -r tsconfig-paths/register\" typeorm",
    "migrations:run": "npm run typeorm -- migration:run -d src/storage/data-source.ts",
    "migrations:generate": "npm run typeorm -- migration:generate src/storage/migrations/migration -d src/storage/data-source.ts",
    "migrations:apply": "typeorm migration:run -d dist/src/storage/data-source.js",
    "crypto:key": "node -p 'crypto.randomBytes(64).toString(\"base64\")'",
    "postgres:init": "docker run --rm --env-file .env -v \"$(pwd)/init-scripts:/docker-entrypoint-initdb.d:ro\" -v pg-data:/var/lib/postgresql/data postgres:17"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "11.0.0",
    "amqplib": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "naughty-util": "^0.7.0",
    "passwords": "github:NaughtySora/passwords",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@config/(.*)$": "<rootDir>/src/config/$1",
      "^@transport/(.*)$": "<rootDir>/src/transport/$1",
      "^@application/(.*)$": "<rootDir>/src/application/$1",
      "^@storage/(.*)$": "<rootDir>/src/storage/$1"
    }
  }
}